<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane prefHeight="270.0" prefWidth="500.0" style="-fx-background-color: white;"
	xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.wheezy.apps.vidcapproc.controller.GameEditorController">
	<children>
		<GridPane hgap="12.0" vgap="10.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0"
			AnchorPane.topAnchor="20.0">
			<columnConstraints>
				<ColumnConstraints minWidth="110.0" prefWidth="110.0" />
				<ColumnConstraints hgrow="ALWAYS" />
			</columnConstraints>
			<children>
				<Label text="Game Title:" GridPane.rowIndex="0" />
				<TextField fx:id="gameTitleField" promptText="For example: Battlefield 3"
					GridPane.columnIndex="1" GridPane.rowIndex="0" />

				<Label text="Filename Label:" GridPane.rowIndex="1" />
				<TextField fx:id="filenameLabelField" promptText="For example: BF3 (optional)"
					GridPane.columnIndex="1" GridPane.rowIndex="1" />

				<Label fx:id="filenameExampleLabel" style="-fx-text-fill: #555555; -fx-font-size: 11;"
					GridPane.columnIndex="1" GridPane.rowIndex="2" />

				<Label text="Game Icon:" GridPane.rowIndex="3" GridPane.valignment="TOP" />
				<HBox alignment="CENTER_LEFT" spacing="14.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
					<children>
						<StackPane minHeight="70.0" minWidth="70.0" prefHeight="70.0" prefWidth="70.0"
							style="-fx-border-color: #d0d0d0; -fx-border-radius: 3;">
							<children>
								<ImageView fx:id="iconImageView" fitHeight="64.0" fitWidth="64.0" pickOnBounds="true"
									preserveRatio="true" />
							</children>
						</StackPane>
						<Button fx:id="browseButton" onAction="#browseForIcon" text="Browse..." />
					</children>
				</HBox>

				<Label fx:id="errorLabel" style="-fx-text-fill: #c62828;" wrapText="true"
					GridPane.columnIndex="1" GridPane.rowIndex="4" />
			</children>
		</GridPane>
		<FlowPane alignment="BOTTOM_RIGHT" hgap="12.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="20.0"
			AnchorPane.rightAnchor="20.0">
			<children>
				<Button fx:id="saveButton" defaultButton="true" onAction="#save" text="Save" />
				<Button cancelButton="true" onAction="#close" text="Cancel" />
			</children>
		</FlowPane>
	</children>
</AnchorPane>
