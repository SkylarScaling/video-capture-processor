<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import com.wheezy.apps.vidcapproc.ui.elements.GameSelectorButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="290.0" prefWidth="277.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wheezy.apps.vidcapproc.controller.VideoCaptureProcessorController">
	<children>
		<VBox alignment="CENTER" layoutX="125.0" AnchorPane.leftAnchor="125.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="0.0">
			<children>
				<Button fx:id="markClipButton" onAction="#markClip" prefHeight="47.0" prefWidth="126.0" style="-fx-background-color: #1b8fd1ff;" text="Mark Clip" textAlignment="CENTER">
					<font>
						<Font name="Montserrat Bold" size="18.0" />
					</font>
					<VBox.margin>
						<Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
					</VBox.margin>
				</Button>
				<TextField fx:id="clipLabelField" prefWidth="126.0" promptText="Clip label (optional)">
					<VBox.margin>
						<Insets bottom="10.0" left="5.0" right="5.0" />
					</VBox.margin>
				</TextField>
				<Button fx:id="keepersButton" onAction="#saveKeeper" prefHeight="40.0" prefWidth="126.0" style="-fx-background-color: #6ed11bff;" text="Keepers" textAlignment="CENTER">
					<font>
						<Font name="Montserrat Bold" size="18.0" />
					</font>
					<VBox.margin>
						<Insets bottom="5.0" left="5.0" right="5.0" />
					</VBox.margin>
				</Button>
				<Button fx:id="clipsButton" onAction="#saveClip" prefHeight="40.0" prefWidth="126.0" style="-fx-background-color: #6f9bff;" text="Clips" textAlignment="CENTER">
					<font>
						<Font name="Montserrat Bold" size="18.0" />
					</font>
					<VBox.margin>
						<Insets left="5.0" right="5.0" />
					</VBox.margin>
				</Button>
			</children>
         <padding>
            <Insets bottom="15.0" top="15.0" />
         </padding>
		</VBox>
		<Label fx:id="statusLabel" alignment="CENTER" text="" textAlignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
			<font>
				<Font name="Montserrat Regular" size="12.0" />
			</font>
			<effect>
				<DropShadow color="#0000004d" />
			</effect>
         <padding>
            <Insets bottom="15.0" top="15.0" />
         </padding>
		</Label>
		<StackPane prefHeight="37.0" prefWidth="7.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
			<children>
				<ImageView fitHeight="37.0" fitWidth="7.0" pickOnBounds="true" preserveRatio="true">
					<image>
						<Image url="@../icons/more-vertical.png" />
					</image>
					<effect>
						<DropShadow color="#00000081" />
					</effect>
				</ImageView>
				<Button fx:id="settingsButton" onAction="#openSettingsDialog" alignment="CENTER" contentDisplay="CENTER" graphicTextGap="0.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="37.0" prefWidth="7.0" text="" />
			</children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
		</StackPane>
		<StackPane prefHeight="84.0" prefWidth="84.0" AnchorPane.leftAnchor="35.0" AnchorPane.topAnchor="0.0">
			<children>
				<GameSelectorButton fx:id="gameButton" onAction="#openGameSelectorDialog" contentDisplay="CENTER" graphicTextGap="0.0" minHeight="-Infinity" minWidth="-Infinity" text=" ">
               <StackPane.margin>
                  <Insets />
               </StackPane.margin></GameSelectorButton>
			</children>
         <padding>
            <Insets bottom="15.0" right="15.0" top="15.0" />
         </padding>
		</StackPane>
		<StackPane layoutX="6.0" layoutY="147.0" prefHeight="20.0" prefWidth="20.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="9.0">
			<children>
				<ImageView fitHeight="28.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
					<image>
						<Image url="@../icons/trash.png" />
					</image>
					<effect>
						<DropShadow color="#00000081" />
					</effect>
				</ImageView>
				<Button fx:id="cleanupButton" onAction="#cleanupFiles" alignment="CENTER" contentDisplay="CENTER" ellipsisString="" graphicTextGap="0.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="28.0" prefWidth="28.0" text=" " textAlignment="CENTER" />
			</children>
		</StackPane>
	</children>
</AnchorPane>
