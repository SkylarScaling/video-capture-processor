<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="560.0" prefWidth="640.0" style="-fx-background-color: white;"
	xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.wheezy.apps.vidcapproc.controller.GameManagerController">
	<children>
		<Button fx:id="addGameButton" onAction="#addGame" text="Add Game..."
			AnchorPane.leftAnchor="14.0" AnchorPane.topAnchor="14.0" />
		<Label fx:id="summaryLabel" style="-fx-text-fill: #555555;"
			AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="18.0" />
		<Label style="-fx-text-fill: #555555; -fx-font-size: 11;"
			text="Click a game to show or hide it in the game selector."
			AnchorPane.leftAnchor="14.0" AnchorPane.topAnchor="46.0" />
		<ScrollPane fx:id="gameScrollPane" fitToWidth="true" hbarPolicy="NEVER"
			AnchorPane.bottomAnchor="58.0" AnchorPane.leftAnchor="9.0" AnchorPane.rightAnchor="9.0"
			AnchorPane.topAnchor="70.0">
			<content>
				<VBox fx:id="gameListBox" spacing="6.0">
					<padding>
						<Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
					</padding>
				</VBox>
			</content>
		</ScrollPane>
		<Button cancelButton="true" onAction="#close" text="Close"
			AnchorPane.bottomAnchor="15.0" AnchorPane.rightAnchor="14.0" />
	</children>
</AnchorPane>
